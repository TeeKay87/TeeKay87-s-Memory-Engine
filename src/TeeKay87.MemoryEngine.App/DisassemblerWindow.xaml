<Window x:Class="TeeKay87.MemoryEngine.App.DisassemblerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TeeKay87.MemoryEngine.App.Controls"
        xmlns:input="clr-namespace:TeeKay87.MemoryEngine.App.Input"
        Title="{Binding WindowTitle}"
        Width="1120"
        Height="720"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        Loaded="DisassemblerWindow_Loaded"
        Closed="DisassemblerWindow_Closed">
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}" />
    </Window.InputBindings>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
            <StackPanel>
                <TextBlock Text="Disassembler" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding TargetText}"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            MinWidth="82"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Go to the previous Disassembler address (Alt+Left)."
                            Content="Back" />
                    <Button Grid.Column="2"
                            MinWidth="82"
                            Command="{Binding ForwardCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Go to the next Disassembler address (Alt+Right)."
                            Content="Forward" />
                    <TextBlock Grid.Column="4"
                               VerticalAlignment="Center"
                               Text="Address"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBox Grid.Column="6"
                             MinWidth="200"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                             input:TextBoxInputFilter.Mode="HexAddress"
                             ToolTip="Enter a hexadecimal address inside a readable memory region. The Disassembler shows bounded context before and after this origin address.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding GoToAddressCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="8"
                            MinWidth="82"
                            Command="{Binding GoToAddressCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Go To" />
                    <Button Grid.Column="10"
                            MinWidth="82"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Refresh" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            MinWidth="118"
                            Command="{Binding PreviousRegionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Open the previous readable non-guarded memory region."
                            Content="Previous Region" />
                    <Button Grid.Column="2"
                            MinWidth="96"
                            Command="{Binding RegionStartCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Navigate to the first byte of the current region."
                            Content="Region Start" />
                    <Button Grid.Column="4"
                            MinWidth="96"
                            Command="{Binding RegionEndCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Navigate to the final byte of the current region."
                            Content="Region End" />
                    <Button Grid.Column="6"
                            MinWidth="108"
                            Command="{Binding NextRegionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Open the next readable non-guarded memory region."
                            Content="Next Region" />
                    <Button Grid.Column="8"
                            MinWidth="92"
                            IsEnabled="{Binding CanExport}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ExportButton_Click"
                            Content="Export" />
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Region / Module" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding RegionNameText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding RegionRangeText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding ModuleRelativeText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Visible range" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding VisibleRangeText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Protection" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding ProtectionText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Architecture" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding ArchitectureText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="6"
                           Text="The visible range is decoded as one continuous stream. The origin highlights the decoded instruction that contains the requested address. On variable-length architectures, the first rows may still be best-effort because the context window can begin in the middle of an instruction."
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
            <DataGrid x:Name="DisassemblyDataGrid"
                      ItemsSource="{Binding Instructions}"
                      SelectedItem="{Binding SelectedInstruction, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="None"
                      SelectionChanged="DisassemblyDataGrid_SelectionChanged"
                      PreviewMouseRightButtonDown="DisassemblyDataGrid_PreviewMouseRightButtonDown"
                      ContextMenuOpening="DisassemblyDataGrid_ContextMenuOpening"
                      MouseDoubleClick="DisassemblyDataGrid_MouseDoubleClick"
                      PreviewKeyDown="DisassemblyDataGrid_PreviewKeyDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Follow Target"
                                  Tag="FollowTarget"
                                  InputGestureText="Enter"
                                  Click="FollowTargetMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Copy Address"
                                  Tag="CopyAddress"
                                  Click="CopyAddressMenuItem_Click" />
                        <MenuItem Header="Copy Bytes"
                                  Tag="CopyBytes"
                                  Click="CopyBytesMenuItem_Click" />
                        <MenuItem Header="Copy Instruction"
                                  Tag="CopyInstruction"
                                  Click="CopyInstructionMenuItem_Click" />
                        <MenuItem Header="Copy Address + Instruction"
                                  Tag="CopyAddressInstruction"
                                  Click="CopyAddressInstructionMenuItem_Click" />
                        <MenuItem Header="Copy Selected"
                                  Tag="CopySelected"
                                  InputGestureText="Ctrl+C"
                                  Click="CopySelectedMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Export..."
                                  Tag="ExportDisassembly"
                                  Click="ExportMenuItem_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOriginRow}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SuccessMutedBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOriginRow}" Value="True" />
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource SuccessMutedBrush}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Width="170" Binding="{Binding Address}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Bytes" Width="330" Binding="{Binding Bytes}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Instruction" Width="*" SortMemberPath="Instruction">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:DisassemblySyntaxTextBlock
                                    Style="{StaticResource {x:Type TextBlock}}"
                                    FontFamily="Consolas"
                                    InstructionText="{Binding Instruction}"
                                    SyntaxTokens="{Binding SyntaxTokens}"
                                    IsInstructionValid="{Binding IsValid}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="12,8">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource MutedTextStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock HorizontalAlignment="Right"
                           MaxWidth="560"
                           Text="{Binding ErrorText}"
                           Style="{StaticResource ErrorMessageTextStyle}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
