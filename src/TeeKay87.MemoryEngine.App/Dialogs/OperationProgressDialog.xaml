<Window x:Class="TeeKay87.MemoryEngine.App.Dialogs.OperationProgressDialog"
        Icon="/TeeKay87.MemoryEngine;component/Assets/TK87ME.ico"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="250"
        MinWidth="460"
        MinHeight="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusTextBlock"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="2"
                     Height="14"
                     Minimum="0"
                     Maximum="100"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource InputBackgroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DetailTextBlock"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource MutedTextStyle}" />
            <TextBlock x:Name="PercentageTextBlock"
                       Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </Grid>

        <TextBlock x:Name="CancellationStatusTextBlock"
                   Grid.Row="6"
                   Text="Cancellation requested. Finishing the current operation safely..."
                   TextWrapping="Wrap"
                   Style="{StaticResource MutedTextStyle}"
                   Visibility="Collapsed" />

        <Button x:Name="CancelButton"
                Grid.Row="8"
                Width="100"
                HorizontalAlignment="Right"
                Style="{StaticResource DangerButtonStyle}"
                Click="CancelButton_Click"
                Content="Cancel" />
    </Grid>
</Window>
