<Window x:Class="TeeKay87.MemoryEngine.App.Dialogs.DataExportDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="500"
        MinWidth="520"
        MinHeight="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Border Margin="18"
            Padding="18"
            Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Scope"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="ScopeComboBox"
                      Grid.Row="2"
                      SelectionChanged="ScopeComboBox_SelectionChanged"
                      DisplayMemberPath="DisplayName" />

            <TextBlock x:Name="ScopeDescriptionTextBlock"
                       Grid.Row="4"
                       TextWrapping="Wrap"
                       Style="{StaticResource MutedTextStyle}" />

            <TextBlock Grid.Row="6"
                       Text="Format"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="FormatComboBox"
                      Grid.Row="8"
                      DisplayMemberPath="DisplayName" />

            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Columns"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button Grid.Column="2"
                        MinWidth="86"
                        Padding="8,2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SelectAllColumnsButton_Click"
                        Content="Select All" />
            </Grid>

            <Border Grid.Row="12"
                    Padding="10"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ColumnsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,3"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Content="{Binding Header}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="14"
                    Height="1"
                    Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ValidationTextBlock"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        MinWidth="96"
                        Style="{StaticResource DangerButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Content="Cancel" />
                <Button Grid.Column="2"
                        MinWidth="104"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="ExportButton_Click"
                        Content="Continue" />
            </Grid>
        </Grid>
    </Border>
</Window>
