<Window x:Class="TeeKay87.MemoryEngine.App.Dialogs.BreakpointDialog"
        Icon="/TeeKay87.MemoryEngine;component/Assets/TK87ME.ico"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:TeeKay87.MemoryEngine.App.Input"
        Width="560"
        MinWidth="520"
        MaxWidth="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="BreakpointDialog_Loaded">
    <Border Margin="18"
            Padding="18"
            Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Add Breakpoint / Watchpoint"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Create a debugger stop condition for the current target."
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="Type"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="KindComboBox"
                      Grid.Row="4"
                      SelectionChanged="KindComboBox_SelectionChanged">
                <ComboBoxItem x:Name="SoftwareBreakpointItem"
                              Content="Software Execute Breakpoint" />
                <ComboBoxItem x:Name="HardwareWatchpointItem"
                              Content="Hardware Watchpoint" />
            </ComboBox>

            <TextBlock Grid.Row="6"
                       Text="Address"
                       FontWeight="SemiBold" />
            <TextBox x:Name="AddressTextBox"
                     Grid.Row="8"
                     FontFamily="Consolas"
                     input:TextBoxInputFilter.Mode="HexAddress" />

            <Grid x:Name="HardwareOptionsGrid"
                  Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Access"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="2"
                           Text="Size (bytes)"
                           FontWeight="SemiBold" />

                <ComboBox x:Name="AccessComboBox"
                          Grid.Row="2"
                          Grid.Column="0"
                          SelectedIndex="1">
                    <ComboBoxItem Tag="Read"
                                  Content="Read" />
                    <ComboBoxItem Tag="Write"
                                  Content="Write" />
                    <ComboBoxItem Tag="ReadWrite"
                                  Content="Read / Write" />
                </ComboBox>
                <TextBox x:Name="SizeTextBox"
                         Grid.Row="2"
                         Grid.Column="2"
                         input:TextBoxInputFilter.Mode="UnsignedInteger"
                         Text="4" />
            </Grid>

            <CheckBox x:Name="TemporaryCheckBox"
                      Grid.Row="12"
                      Content="Temporary (remove after first hit)" />

            <Border Grid.Row="14"
                    Padding="10,8"
                    Background="{DynamicResource AccentMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <TextBlock x:Name="ScopeTextBlock"
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}" />
            </Border>

            <TextBlock x:Name="ValidationTextBlock"
                       Grid.Row="16"
                       Foreground="{DynamicResource ErrorTextBrush}"
                       TextWrapping="Wrap" />

            <Border Grid.Row="18"
                    Height="1"
                    Background="{DynamicResource BorderBrush}" />

            <StackPanel Grid.Row="20"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="96"
                        Style="{StaticResource DangerButtonStyle}"
                        IsCancel="True"
                        Content="Cancel" />
                <Button MinWidth="104"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddButton_Click"
                        Content="Add" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
