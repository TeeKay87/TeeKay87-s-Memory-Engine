<Window x:Class="TeeKay87.MemoryEngine.App.Dialogs.ManualSavedAddressDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:TeeKay87.MemoryEngine.App.Input"
        Width="660"
        Height="720"
        MinWidth="620"
        MinHeight="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="ManualSavedAddressDialog_Loaded">
    <Border Margin="18"
            Padding="18"
            Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Add Saved Address Manually"
                               Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="TargetTextBlock"
                               Margin="0,4,0,0"
                               Style="{StaticResource MutedTextStyle}" />

                    <TextBlock Margin="0,18,0,5"
                               Text="Address"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="AddressTextBox"
                             input:TextBoxInputFilter.Mode="HexAddress"
                             ToolTip="Enter a hexadecimal address, with or without a 0x prefix." />

                    <TextBlock Margin="0,12,0,5"
                               Text="Current value"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="CurrentValueTextBox"
                             IsReadOnly="True"
                             Text="Read immediately after adding." />
                    <TextBlock Margin="0,4,0,0"
                               Text="The new Saved Address is refreshed from the Active Target as soon as it is added."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />

                    <TextBlock Margin="0,12,0,5"
                               Text="Description"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="DescriptionTextBox"
                             MaxLength="512"
                             ToolTip="Optional user description for the Saved Address." />

                    <TextBlock Margin="0,12,0,5"
                               Text="Value Type"
                               FontWeight="SemiBold" />
                    <ComboBox x:Name="ValueTypeComboBox"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="ValueTypeComboBox_SelectionChanged" />
                    <TextBlock x:Name="ValueTypeDescriptionTextBlock"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />

                    <TextBlock Margin="0,12,0,5"
                               Text="Length"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="LengthTextBox"
                             Width="120"
                             HorizontalAlignment="Left"
                             input:TextBoxInputFilter.Mode="UnsignedInteger"
                             ToolTip="Fixed-size Value Types show their required byte count. Variable-size Value Types accept 1 through 4,096 bytes." />
                    <TextBlock x:Name="LengthDescriptionTextBlock"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />

                    <Border Margin="0,18,0,0"
                            Padding="12"
                            Background="{DynamicResource PanelSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Additional display / type options"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,8"
                                       Text="These controls reserve planned functionality that is not implemented yet. They are intentionally disabled. Signedness is already represented by the selected Value Type."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />

                            <CheckBox IsEnabled="False"
                                      Content="Hexadecimal display (planned)" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="Start bit" />
                                <TextBox Grid.Column="2"
                                         IsEnabled="False"
                                         Text="0"
                                         ToolTip="Planned for a future Binary Value Type." />
                                <CheckBox Grid.Column="4"
                                          IsEnabled="False"
                                          VerticalAlignment="Center"
                                          Content="Unicode"
                                          ToolTip="Planned for a future Text Value Type." />
                                <CheckBox Grid.Column="6"
                                          IsEnabled="False"
                                          VerticalAlignment="Center"
                                          Content="Code page"
                                          ToolTip="Planned for a future Text Value Type." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="12"
                            Background="{DynamicResource PanelSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <CheckBox IsEnabled="False"
                                      FontWeight="SemiBold"
                                      Content="Pointer (planned)" />
                            <TextBlock Margin="0,4,0,8"
                                       Text="Pointer base-address resolution and multi-level offsets will be added through a platform-neutral pointer model before these controls are enabled."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />

                            <Grid IsEnabled="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           Text="Base address" />
                                <TextBox Grid.Column="1"
                                         Text="0x0000000000000000" />

                                <TextBlock Grid.Row="2"
                                           VerticalAlignment="Center"
                                           Text="Offset" />
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="0" />
                                    <Button Grid.Column="2"
                                            MinWidth="88"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Add Offset" />
                                    <Button Grid.Column="4"
                                            MinWidth="104"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Remove Offset" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ValidationTextBlock"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource ErrorTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Height="1"
                    Background="{DynamicResource BorderBrush}" />

            <StackPanel Grid.Row="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="96"
                        Style="{StaticResource DangerButtonStyle}"
                        IsCancel="True"
                        Content="Cancel" />
                <Button MinWidth="112"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="AddButton_Click"
                        Content="Add" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
