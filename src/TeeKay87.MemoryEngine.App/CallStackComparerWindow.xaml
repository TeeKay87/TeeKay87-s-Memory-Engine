<Window x:Class="TeeKay87.MemoryEngine.App.CallStackComparerWindow"
        Icon="/TeeKay87.MemoryEngine;component/Assets/TK87ME.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TeeKay87.MemoryEngine.App.Controls"
        Title="Call Stack Comparer" Width="1240" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SnapshotGroupComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEditable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1,0,0,0">
                                                    <Path Width="9"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 4.5 5 L 9 0 Z"
                                                          Fill="{TemplateBinding Foreground}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="10,0,34,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="180"
                                        MaxHeight="360"
                                        Margin="0,3,0,0"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Margin="5"
                                                HorizontalContentAlignment="Left"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Click="SnapshotNoGroupButton_Click"
                                                Content="No group"
                                                ToolTip="Remove this snapshot from its current group." />
                                        <Border Grid.Row="1"
                                                Padding="5"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,1,0,1">
                                            <TextBox x:Name="NewSnapshotGroupTextBox"
                                                     Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                     ToolTip="Type a new group name and press Enter to create and assign it to this snapshot."
                                                     PreviewKeyDown="SnapshotNewGroupTextBox_PreviewKeyDown" />
                                        </Border>
                                        <ScrollViewer Grid.Row="2"
                                                      Margin="1"
                                                      CanContentScroll="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}" />
                                <Setter Property="Background" Value="{DynamicResource DisabledButtonBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DisabledButtonBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Call Stack Comparer" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Margin="0,4,0,0" Text="Compare live-captured and imported debugger snapshots without target traffic." Style="{StaticResource MutedTextStyle}"/></StackPanel>
                <WrapPanel Grid.Column="1">
                    <Button MinWidth="108" Margin="0,0,8,0" IsEnabled="{Binding CanCaptureCurrent}" Click="CaptureCurrentButton_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Capture Current"/>
                    <Button MinWidth="82" Margin="0,0,8,0" Click="ImportButton_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Import..."/>
                    <Button x:Name="SnapshotExportButton" MinWidth="82" Margin="0,0,8,0" IsEnabled="{Binding CanExportSnapshot}" Click="ExportButton_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Export..."/>
                    <Button x:Name="ExportResultsButton" MinWidth="112" IsEnabled="{Binding HasResults}" Click="ExportResultsButton_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Export Results..."/>
                </WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="8">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <DataGrid x:Name="SnapshotGrid"
                              IsReadOnly="False"
                              ItemsSource="{Binding Snapshots}"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              SelectionChanged="SnapshotGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Label" Width="*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Click to edit the snapshot label." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Group" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableGroups}"
                                                  SelectedItem="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource SnapshotGroupComboBoxStyle}"
                                                  DropDownOpened="SnapshotGroupComboBox_DropDownOpened"
                                                  ToolTip="Open the list to create a new session group or select an existing group for this snapshot." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Notes" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Click to add or edit snapshot notes." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Captured" Width="145" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><TextBlock Text="{Binding Captured}" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Source" Width="80" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><TextBlock Text="{Binding Source}" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Event" Width="100" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><TextBlock Text="{Binding Event}" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trigger" Width="130" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><TextBlock Text="{Binding Trigger}" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Stop IP" Width="130" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><TextBlock Text="{Binding StopIp}" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Process" Width="140" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><TextBlock Text="{Binding Process}" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Height="28"
                                                Margin="5,2"
                                                Padding="8,2"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="RemoveSnapshotRowButton_Click"
                                                Content="Remove"
                                                ToolTip="Remove this snapshot from the comparer." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="No snapshots."
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSnapshots}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <WrapPanel><Button x:Name="ComparePairButton" MinWidth="92" Margin="0,0,8,0" IsEnabled="{Binding CanComparePair}" Click="CompareSelectedButton_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Compare 2"/>
                        <Button x:Name="RemoveAllButton" MinWidth="92" IsEnabled="{Binding HasSnapshots}" Click="RemoveAllButton_Click" Style="{StaticResource DangerButtonStyle}" Content="Remove All"/></WrapPanel>
                    <WrapPanel Grid.Column="2"><TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Group A" Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="GroupAComboBox" Width="130" Margin="0,0,8,0" ItemsSource="{Binding GroupNames}" SelectedItem="{Binding SelectedGroupA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" ToolTip="Select a snapshot group created in the Group column."/>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Group B" Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="GroupBComboBox" Width="130" Margin="0,0,8,0" ItemsSource="{Binding GroupNames}" SelectedItem="{Binding SelectedGroupB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" ToolTip="Select a snapshot group created in the Group column."/>
                        <Button x:Name="CompareGroupsButton" MinWidth="112" IsEnabled="{Binding CanCompareGroups}" Click="CompareGroupsButton_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Compare Groups"/></WrapPanel>
                </Grid>
            </Grid>
        </Border>
        <controls:ProportionalGridSplitter Grid.Row="3" Style="{StaticResource RowWorkspaceSplitterStyle}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" MinimumPreviousRatio="0.2" MaximumPreviousRatio="0.8" ShowsPreview="False"/>
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="8">
            <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow">
                <DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="Group A" Binding="{Binding GroupA}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Group B" Binding="{Binding GroupB}" Width="*" MinWidth="160"/><DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="210"/>
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" MinWidth="220"/></DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="6" Style="{StaticResource CardBorderStyle}" Padding="12,8"><TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
