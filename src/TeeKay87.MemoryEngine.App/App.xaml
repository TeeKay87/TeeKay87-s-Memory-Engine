<Application x:Class="TeeKay87.MemoryEngine.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/ControlStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Emergency fallback palette. Normal startup replaces these brushes from external theme JSON files. -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F14" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#121821" />
            <SolidColorBrush x:Key="PanelSecondaryBrush" Color="#171F2A" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1D2734" />
            <SolidColorBrush x:Key="BorderBrush" Color="#263242" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#3B4A5F" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="AccentMutedBrush" Color="#16384A" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#19465C" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#171F2A" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#334155" />
            <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#081018" />
            <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#171F2A" />
            <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#263242" />
            <SolidColorBrush x:Key="SecondaryButtonTextBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#151D27" />
            <SolidColorBrush x:Key="DisabledButtonBorderBrush" Color="#334155" />
            <SolidColorBrush x:Key="DisabledButtonTextBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#7F1D1D" />
            <SolidColorBrush x:Key="DangerButtonBorderBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="DangerButtonTextBrush" Color="#FEF2F2" />
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#FCA5A5" />
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#86EFAC" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#FCD34D" />
            <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#0F1720" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3B4A5F" />
            <SolidColorBrush x:Key="ToolTipTextBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonPressedOverlayBrush" Color="#000000" />

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
