<Window x:Class="TeeKay87.MemoryEngine.App.Settings.SettingsWindow"
        Icon="/TeeKay87.MemoryEngine;component/Assets/TK87ME.ico"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:TeeKay87.MemoryEngine.App.Input"
        Title="Settings"
        Width="720"
        SizeToContent="Height"
        MinWidth="620"
        MinHeight="350"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="Application-level configuration that applies regardless of the active platform plugin."
                       Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Saved Addresses"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Margin="0,5,0,0"
                           Text="Controls how often Saved Addresses refresh their displayed values and how often Frozen entries reapply their saved value. The two operations use independent intervals."
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="Value refresh (ms)"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBox x:Name="SavedAddressesUpdateIntervalTextBox"
                             input:TextBoxInputFilter.Mode="UnsignedInteger"
                             Grid.Column="1"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="3"
                            MinWidth="104"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="UseDefaultSavedAddressesIntervalButton_Click"
                            Content="Use Default" />

                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               Text="Frozen write (ms)"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBox x:Name="FrozenWriteIntervalTextBox"
                             input:TextBoxInputFilter.Mode="UnsignedInteger"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                    <Button Grid.Row="2"
                            Grid.Column="3"
                            MinWidth="104"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="UseDefaultFrozenWriteIntervalButton_Click"
                            Content="Use Default" />
                </Grid>

                <TextBlock Margin="0,10,0,0"
                           Text="Allowed range for both intervals: 50-10,000 ms. Value refresh defaults to 500 ms; Frozen writes default to 100 ms. Value refresh pauses during a scan. Frozen writes continue during a scan unless Pause target while scanning is enabled."
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Scan Results Storage Location"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Margin="0,5,0,0"
                           Text="Temporary scan-session files are stored under this managed location. Complete disk-backed result sets are retained here for the active scan session while the results table keeps only a bounded preview in memory."
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="StoragePathTextBox"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            MinWidth="92"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseButton_Click"
                            Content="Browse..." />
                    <Button Grid.Column="4"
                            MinWidth="104"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="UseDefaultButton_Click"
                            Content="Use Default" />
                </Grid>

                <TextBlock Margin="0,12,0,0"
                           Text="Active for this application session:"
                           Style="{StaticResource MutedTextStyle}" />
                <TextBlock x:Name="ActiveStoragePathTextBlock"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,10,0,0"
                           Text="A changed location is saved for the next application session. Active scan-session files are never migrated between storage roots while the program is running."
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}" />

                <TextBlock x:Name="ValidationErrorTextBlock"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SaveStatusTextBlock"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}" />
            <Button Grid.Column="1"
                    MinWidth="88"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="CancelButton_Click"
                    Content="Cancel" />
            <Button Grid.Column="3"
                    MinWidth="88"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"
                    Content="Save" />
        </Grid>
    </Grid>
</Window>
