<Window x:Class="TeeKay87.MemoryEngine.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="28,22"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding ApplicationTitle}"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0"
                               Text="Modular memory scanning, debugging and cheat-development foundation"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Background="{StaticResource AccentMutedBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Text="{Binding DisplayVersion}"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Platform Plugins"
                               FontSize="17"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1"
                               Margin="0,5,0,14"
                               Text="Capabilities are supplied by plugins rather than hard-coded per platform."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Plugins}"
                             SelectedItem="{Binding SelectedPlugin}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12"
                                        Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Platform}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3"
                            Margin="0,14,0,0"
                            Command="{Binding ReloadPluginsCommand}"
                            Content="Reload Plugins" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="24"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected Plugin"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding SelectedPlugin.Name, TargetNullValue='No plugin selected'}"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SelectedPlugin.Description}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Platform" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPlugin.Platform}" />

                            <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="Backend" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedPlugin.Backend}" />

                            <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="Plugin Version" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedPlugin.Version}" />

                            <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="Architecture" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedPlugin.ArchitectureDisplay}" />

                            <TextBlock Grid.Row="4" Margin="0,10,0,0" Text="Assembly" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedPlugin.AssemblyPath}" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Margin="0,28,0,10"
                                   Text="Capabilities"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{Binding SelectedPlugin.Capabilities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8"
                                            Padding="10,5"
                                            Background="{StaticResource AccentMutedBrush}"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,24,0,0"
                                Padding="16"
                                Background="{StaticResource PanelSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <StackPanel>
                                <TextBlock Text="Foundation milestone"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding FeatureTitle}"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="The application now discovers platform plugins through a shared SDK. Live target connection and PS5 integration are intentionally reserved for the next development milestone."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,20,0,0"
                                   Text="{Binding ErrorText}"
                                   Foreground="#FCA5A5"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding PluginDirectory}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
