<Window x:Class="TeeKay87.MemoryEngine.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TeeKay87.MemoryEngine.App.Controls"
        xmlns:application="clr-namespace:TeeKay87.MemoryEngine.App.Application"
        xmlns:input="clr-namespace:TeeKay87.MemoryEngine.App.Input"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1460"
        Height="880"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact application bar. The primary workflow begins immediately below, similar to classic memory tools. -->
        <Border Grid.Row="0"
                Padding="16,10"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Text="{Binding ApplicationTitle}"
                           FontSize="18"
                           FontWeight="SemiBold" />


                <Button Grid.Column="2"
                        MinWidth="86"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenSettingsButton_Click"
                        Content="Settings" />

                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           Text="Theme"
                           Style="{StaticResource MutedTextStyle}" />

                <ComboBox Grid.Column="6"
                          Width="130"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          DisplayMemberPath="Name" />
            </Grid>
        </Border>

        <!-- Target and connection controls stay visible while the user works, following Cheat Engine's target-first workflow. -->
        <Border x:Name="TargetConnectionBar"
                Grid.Row="1"
                Padding="14,8"
                Background="{DynamicResource PanelSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <!--
                    Permanent first row: platform, plugin-declared connection inputs, connection actions,
                    process selection, and Active Target actions. Standard top-row TextBox/ComboBox inputs
                    share one responsive host width. Ordinary inputs never exceed
                    UiMetrics.TopTargetInputMaxWidth and shrink together when the row becomes constrained.
                -->
                <StackPanel x:Name="TopTargetFirstRow"
                            Orientation="Horizontal"
                            LayoutUpdated="TopTargetFirstRow_LayoutUpdated">
                    <StackPanel Width="{Binding TopTargetInputWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                MaxWidth="{x:Static application:UiMetrics.TopTargetInputMaxWidth}">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Platform"
                                   Style="{StaticResource MutedTextStyle}" />
                        <ComboBox ItemsSource="{Binding Plugins}"
                                  SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <ItemsControl x:Name="TopTargetConnectionSettings"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Bottom"
                                  ItemsSource="{Binding SelectedPlugin.ConnectionSettings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="{Binding TopTargetInputWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            MaxWidth="{x:Static application:UiMetrics.TopTargetInputMaxWidth}"
                                            Margin="0,0,10,0">
                                    <TextBlock Margin="0,0,0,5"
                                               Text="{Binding Label}"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="ConnectButton"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SelectedPlugin.ConnectCommand}"
                            Content="Connect" />

                    <Button x:Name="DisconnectButton"
                            MinWidth="96"
                            Margin="0,0,12,0"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding SelectedPlugin.DisconnectCommand}"
                            Content="Disconnect" />

                    <StackPanel x:Name="TargetProcessPanel"
                                Width="{Binding TopTargetInputWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                MaxWidth="{x:Static application:UiMetrics.TopTargetInputMaxWidth}"
                                Margin="0,0,8,0"
                                Visibility="{Binding SelectedPlugin.SupportsProcessEnumeration, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Target Process"
                                   Style="{StaticResource MutedTextStyle}" />
                        <ComboBox ItemsSource="{Binding SelectedPlugin.Processes}"
                                  SelectedItem="{Binding SelectedPlugin.SelectedProcess, Mode=TwoWay}"
                                  DisplayMemberPath="SelectionDisplay" />
                    </StackPanel>

                    <Button x:Name="RefreshProcessesButton"
                            MinWidth="82"
                            Margin="0,0,8,0"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding SelectedPlugin.SupportsProcessEnumeration, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SelectedPlugin.RefreshProcessesCommand}"
                            Content="Refresh" />

                    <Button x:Name="SetActiveTargetButton"
                            MinWidth="126"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding SelectedPlugin.SupportsProcessEnumeration, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SelectedPlugin.SetActiveProcessCommand}"
                            Content="Set Active Target" />
                </StackPanel>

                <!--
                    Permanent second row: host/tool actions. New top-level tool/action buttons belong here
                    rather than creating an additional target/connection row.
                -->
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button MinWidth="112"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ReloadPluginsCommand}"
                                Content="Reload Plugins" />

                        <Button MinWidth="112"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding SelectedPlugin.CanOpenDisassembler}"
                                Visibility="{Binding SelectedPlugin.SupportsDisassembly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OpenDisassemblerButton_Click"
                                ToolTip="Open the Disassembler for the current Active Target."
                                Content="Disassembler..." />

                        <Button MinWidth="102"
                                IsEnabled="{Binding SelectedPlugin.CanOpenDebugger}"
                                Visibility="{Binding SelectedPlugin.SupportsDebugger, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OpenDebuggerButton_Click"
                                ToolTip="Open the Debugger workspace for the current Active Target."
                                Content="Debugger..." />
                    </StackPanel>

                    <Expander Grid.Column="4"
                              Header="Plugin details"
                              HorizontalAlignment="Right">
                        <Border Width="650"
                                Margin="0,8,0,0"
                                Padding="12"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Platform" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPlugin.Platform}" />
                                    <TextBlock Grid.Column="2" Text="Backend" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SelectedPlugin.Backend}" />

                                    <TextBlock Grid.Row="1" Margin="0,6,0,0" Text="Plugin Version" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding SelectedPlugin.Version}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" Text="Plugin API" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" Text="{Binding SelectedPlugin.ApiVersion}" />

                                    <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="Architecture" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Text="{Binding SelectedPlugin.ArchitectureDisplay}" />
                                </Grid>

                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding SelectedPlugin.Description}"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap" />

                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding SelectedPlugin.Capabilities}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6"
                                                    Padding="8,3"
                                                    Background="{DynamicResource AccentMutedBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Expander>
                </Grid>

                <TextBlock Margin="0,5,0,0"
                           Text="{Binding SelectedPlugin.ConnectionErrorText}"
                           Style="{StaticResource ErrorMessageTextStyle}" />
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding SelectedPlugin.ProcessErrorText}"
                           Style="{StaticResource ErrorMessageTextStyle}" />
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding SelectedPlugin.MemoryRegionErrorText}"
                           Style="{StaticResource ErrorMessageTextStyle}" />
            </StackPanel>
        </Border>

        <!-- Main memory workspace. Scan Results and Saved Addresses share the left column while Scan remains full-height on the right. -->
        <Grid Grid.Row="2" Margin="12,12,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="640" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="310" MinWidth="280" MaxWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="12,9"
                                Background="{DynamicResource PanelSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="Scan Results"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <Button Grid.Column="2"
                                        MinWidth="90"
                                        IsEnabled="{Binding SelectedPlugin.CanExportScanResults}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ExportScanResultsButton_Click"
                                        Content="Export..." />
                                <TextBlock Grid.Column="4"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedPlugin.ScanResultCountText}"
                                           Style="{StaticResource MutedTextStyle}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="ScanResultsDataGrid"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding SelectedPlugin.ScanResults}"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      LoadingRow="ScanResultsDataGrid_LoadingRow"
                                      UnloadingRow="ScanResultsDataGrid_UnloadingRow"
                                      MouseDoubleClick="ScanResultsDataGrid_MouseDoubleClick"
                                      ContextMenuOpening="ScanResultsDataGrid_ContextMenuOpening">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Save Address" Click="ScanResultsSaveAddressMenuItem_Click" />
                                        <MenuItem Header="Open in Memory Viewer" Click="ScanResultOpenMemoryViewerMenuItem_Click" />
                                        <MenuItem Header="Open in Disassembler"
                                                  Tag="OpenDisassembler"
                                                  Click="ScanResultOpenDisassemblerMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Copy address" Command="{Binding CopyAddressCommand}" />
                                        <MenuItem Header="Copy value" Command="{Binding CopyValueCommand}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Address" Width="160" Binding="{Binding Address}" />
                                    <DataGridTextColumn Header="Value" Width="160" Binding="{Binding Value}" />
                                    <DataGridTextColumn Header="Previous" Width="160" Binding="{Binding Previous}" />
                                    <DataGridTextColumn Header="Type" Width="120" Binding="{Binding Type}" />
                                    <DataGridTextColumn Header="Protection" Width="150" Binding="{Binding Protection}" />
                                    <DataGridTextColumn Header="Region / Module" Width="*" Binding="{Binding Region}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedPlugin.ScanEmptyMessage}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedTextStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlugin.HasVisibleScanResults}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="2"
                                Padding="10,6"
                                Background="{DynamicResource PanelSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding SelectedPlugin.ScanResultFooterText}"
                                       Style="{StaticResource MutedTextStyle}" />
                        </Border>
                    </Grid>
                </Border>

                <controls:ProportionalGridSplitter Grid.Row="1"
                                                   Style="{StaticResource RowWorkspaceSplitterStyle}"
                                                   ResizeDirection="Rows"
                                                   ResizeBehavior="PreviousAndNext"
                                                   MinimumPreviousRatio="0.2"
                                                   MaximumPreviousRatio="0.8"
                                                   ShowsPreview="False" />

                <!-- Shared persistent address table. Scan sessions may be reset without altering this collection. -->
                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="12,8"
                                Background="{DynamicResource PanelSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           Text="Saved Addresses"
                                           Style="{StaticResource SectionTitleTextStyle}" />

                                <Button Grid.Column="2"
                                        MinWidth="112"
                                        IsEnabled="{Binding SelectedPlugin.CanAddSavedAddressManually}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="AddManualSavedAddressButton_Click"
                                        Content="Add Manually" />
                                <Button Grid.Column="4"
                                        MinWidth="92"
                                        IsEnabled="{Binding SelectedPlugin.HasSavedAddresses}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="RemoveAllSavedAddressesButton_Click"
                                        Content="Remove All" />
                                <Button Grid.Column="6"
                                        MinWidth="90"
                                        IsEnabled="{Binding SelectedPlugin.CanExportSavedAddresses}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ExportSavedAddressesButton_Click"
                                        Content="Export" />
                                <TextBlock Grid.Column="8"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedPlugin.SavedAddressCountText}"
                                           Style="{StaticResource MutedTextStyle}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="SavedAddressesDataGrid"
                                      IsReadOnly="False"
                                      AutoGenerateColumns="False"
                                      ItemsSource="{Binding SelectedPlugin.SavedAddresses}"
                                      SelectedItem="{Binding SelectedPlugin.SelectedSavedAddress, Mode=TwoWay}"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      ContextMenuOpening="SavedAddressesDataGrid_ContextMenuOpening">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding FrozenMenuHeader}" Command="{Binding ToggleFrozenCommand}" />
                                        <MenuItem Header="Open in Memory Viewer" Click="SavedAddressOpenMemoryViewerMenuItem_Click" />
                                        <MenuItem Header="Open in Disassembler"
                                                  Tag="OpenDisassembler"
                                                  Click="SavedAddressOpenDisassemblerMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Copy address" Command="{Binding CopyAddressCommand}" />
                                        <MenuItem Header="Copy value" Command="{Binding CopyValueCommand}" />
                                        <Separator />
                                        <MenuItem Header="Remove address" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}"
                                           BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding StatusText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="">
                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Frozen" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsFrozenRequested, Mode=OneWay}"
                                                          Click="SavedAddressFrozenCheckBox_Click"
                                                          ToolTip="Reapply the frozen value at the Frozen write interval configured in Settings." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Description" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Click to add or edit a description." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Address" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding AddressText, Mode=OneWay}"
                                                         input:TextBoxInputFilter.Mode="HexAddress"
                                                         LostKeyboardFocus="SavedAddressAddressTextBox_LostKeyboardFocus"
                                                         KeyDown="SavedAddressAddressTextBox_KeyDown"
                                                         ToolTip="Click to edit the hexadecimal address." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Type" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding ValueTypeOptions}"
                                                          SelectedItem="{Binding SelectedValueType, Mode=OneWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectionChanged="SavedAddressValueTypeComboBox_SelectionChanged"
                                                          ToolTip="Choose a Value Type declared by the active plugin." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Value" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ValueText, Mode=OneWay}"
                                                         input:TextBoxInputFilter.MemoryValueType="{Binding SelectedValueType.ValueType}"
                                                         GotKeyboardFocus="SavedAddressValueTextBox_GotKeyboardFocus"
                                                         LostKeyboardFocus="SavedAddressValueTextBox_LostKeyboardFocus"
                                                         KeyDown="SavedAddressValueTextBox_KeyDown"
                                                         ToolTip="Click to edit and write the value to the active target." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Protection"
                                                            Width="150"
                                                            IsReadOnly="True"
                                                            SortMemberPath="Protection"
                                                            ClipboardContentBinding="{Binding Protection}">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="{x:Type DataGridCell}"
                                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Stretch">
                                                    <TextBlock Text="{Binding Protection}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Height="28"
                                                        Margin="5,2"
                                                        Padding="8,2"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding RemoveCommand}"
                                                        Content="Remove"
                                                        ToolTip="Remove this saved address." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="No saved addresses."
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedTextStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlugin.HasSavedAddresses}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="2"
                                Padding="10,6"
                                Background="{DynamicResource PanelSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock Text="{Binding SelectedPlugin.SavedAddressStatusText}"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SelectedPlugin.SavedAddressUpdateIntervalText}"
                                           Style="{StaticResource MutedTextStyle}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource ColumnWorkspaceSplitterStyle}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Padding="14"
                    Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Top"
                              CanContentScroll="False">
                    <StackPanel Margin="0,0,10,0"
                                IsEnabled="{Binding SelectedPlugin.HasActiveTarget, FallbackValue=False}">
                        <TextBlock Text="Scan" Style="{StaticResource SectionTitleTextStyle}" />

                        <Grid Margin="0,14,0,0"
                              Visibility="{Binding SelectedPlugin.ShowsPrimaryScanValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlugin.ShowsSecondaryScanValue}" Value="False">
                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Margin="0,0,0,5"
                                           Text="{Binding SelectedPlugin.PrimaryScanValueLabel}"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding SelectedPlugin.ScanValueText, UpdateSourceTrigger=PropertyChanged}"
                                         input:TextBoxInputFilter.MemoryValueType="{Binding SelectedPlugin.SelectedScanValueType.ValueType}"
                                         IsEnabled="{Binding SelectedPlugin.SupportsSharedScanner}"
                                         ToolTip="{Binding SelectedPlugin.ScanValueToolTip}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SelectedPlugin.ScanSubmitCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding SelectedPlugin.ShowsSecondaryScanValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,0,0,5"
                                           Text="{Binding SelectedPlugin.SecondaryScanValueLabel}"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding SelectedPlugin.ScanSecondaryValueText, UpdateSourceTrigger=PropertyChanged}"
                                         input:TextBoxInputFilter.MemoryValueType="{Binding SelectedPlugin.SelectedScanValueType.ValueType}"
                                         IsEnabled="{Binding SelectedPlugin.SupportsSharedScanner}"
                                         ToolTip="{Binding SelectedPlugin.ScanValueToolTip}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SelectedPlugin.ScanSubmitCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,5" Text="Scan Type" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox ItemsSource="{Binding SelectedPlugin.ScanTypes}"
                                  SelectedItem="{Binding SelectedPlugin.SelectedScanType, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding SelectedPlugin.CanSelectScanType}"
                                  ToolTip="Scan Types are supplied by Memory Engine Core and filtered to the modes valid for the current First Scan or Next Scan stage and selected Value Type." />

                        <TextBlock Margin="0,12,0,5" Text="Value Type" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox ItemsSource="{Binding SelectedPlugin.ScanValueTypes}"
                                  SelectedItem="{Binding SelectedPlugin.SelectedScanValueType, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding SelectedPlugin.CanSelectScanValueType}"
                                  ToolTip="Value Type is locked after First Scan. Choose New Scan before changing it." />

                        <ItemsControl ItemsSource="{Binding SelectedPlugin.ChoiceScanOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Margin="0,0,0,5"
                                                   Text="{Binding DisplayName}"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <ComboBox ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding IsEnabled}"
                                                  ToolTip="{Binding Description}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding SelectedPlugin.ToggleScanOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,12,0,0"
                                              VerticalAlignment="Center"
                                              Content="{Binding ToggleLabel}"
                                              IsChecked="{Binding IsToggleChecked, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEnabled}"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Margin="0,10,0,0"
                                  VerticalAlignment="Center"
                                  Content="Pause target while scanning"
                                  IsChecked="{Binding SelectedPlugin.PauseTargetWhileScanning, Mode=TwoWay}"
                                  IsEnabled="{Binding SelectedPlugin.CanConfigureScanPause}"
                                  Visibility="{Binding SelectedPlugin.SupportsScanPause, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="Temporarily suspends the Active Target during First Scan or Next Scan, then resumes it automatically. Off by default." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding SelectedPlugin.FirstScanCommand}"
                                    Content="First Scan">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectedPlugin.IsFirstScanPrimaryAction}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding SelectedPlugin.NextScanCommand}"
                                    Content="Next Scan">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectedPlugin.IsNextScanPrimaryAction}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding SelectedPlugin.NewScanCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="New Scan" />
                            <Button Grid.Column="2"
                                    Command="{Binding SelectedPlugin.CancelScanCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Cancel Scan" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="12,6"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="8,2"
                        Background="Transparent"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlugin.IsConnected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessTextBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource SuccessMutedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="Not connected" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPlugin.IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           Style="{StaticResource MutedTextStyle}" />

                <TextBlock Grid.Column="4"
                           MaxWidth="320"
                           Text="{Binding ErrorText}"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="6"
                           Text="{Binding SelectedPlugin.ScanStatusBarText}"
                           ToolTip="{Binding SelectedPlugin.ScanStatusBarText}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlugin.HasScanError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="8"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedPlugin.HasScanProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="170"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding SelectedPlugin.ScanProgressPercentage, Mode=OneWay}"
                                 IsIndeterminate="{Binding SelectedPlugin.IsScanProgressIndeterminate, Mode=OneWay}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1" />
                    <TextBlock MinWidth="68"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding SelectedPlugin.ScanElapsedText}"
                               TextAlignment="Right"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <TextBlock Grid.Column="10"
                           Text="{Binding DisplayVersion}"
                           Style="{StaticResource MutedTextStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
