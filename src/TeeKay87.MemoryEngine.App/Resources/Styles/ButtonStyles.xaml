<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:application="clr-namespace:TeeKay87.MemoryEngine.App.Application">
    <Style x:Key="ButtonBaseStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,2" />
        <Setter Property="Height" Value="{x:Static application:UiMetrics.StandardControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="InteractionOverlay"
                                        Background="{DynamicResource ButtonHoverOverlayBrush}"
                                        CornerRadius="4"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter x:Name="ButtonContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                    <ContentPresenter.Resources>
                                        <!--
                                            WPF may materialize string button content as AccessText or TextBlock.
                                            Give both generated text elements a local style so application-level
                                            text styles cannot override the button's semantic/disabled foreground.
                                        -->
                                        <Style TargetType="{x:Type AccessText}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground"
                                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                             Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground"
                                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                             Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>

                        <Border x:Name="FocusBorder"
                                Margin="-2"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="InteractionOverlay" Property="Background" Value="{DynamicResource ButtonPressedOverlayBrush}" />
                            <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DisabledButtonBackgroundBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource DisabledButtonBorderBrush}" />
                            <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="{DynamicResource DisabledButtonTextBrush}" />
                            <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0" />
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource DisabledButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledButtonBorderBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
    </Style>

    <Style x:Key="DebuggerWorkspaceSwitchButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="11,1" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="DebuggerBreakpointsSwitchButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DebuggerWorkspaceSwitchButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBreakpointsWorkspaceSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DebuggerCallStackSwitchButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DebuggerWorkspaceSwitchButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCallStackWorkspaceSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerButtonTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderBrush}" />
    </Style>

    <Style TargetType="{x:Type Button}"
           BasedOn="{StaticResource SecondaryButtonStyle}" />
</ResourceDictionary>
