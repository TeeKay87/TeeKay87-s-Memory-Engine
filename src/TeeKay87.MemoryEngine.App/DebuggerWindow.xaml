<Window x:Class="TeeKay87.MemoryEngine.App.DebuggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1120"
        Height="720"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        Closed="DebuggerWindow_Closed">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
            <StackPanel>
                <TextBlock Text="Debugger" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding TargetText}"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="State" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Margin="0,3,0,0"
                               MinWidth="80"
                               Text="{Binding StateText}"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Button Grid.Column="2"
                        MinWidth="86"
                        VerticalAlignment="Bottom"
                        Command="{Binding AttachCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Attach the debugger to this window's bound Active Target."
                        Content="Attach" />
                <Button Grid.Column="4"
                        MinWidth="86"
                        VerticalAlignment="Bottom"
                        Command="{Binding PauseCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Pause the attached target."
                        Content="Pause" />
                <Button Grid.Column="6"
                        MinWidth="86"
                        VerticalAlignment="Bottom"
                        Command="{Binding ContinueCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Continue a paused target."
                        Content="Continue" />
                <Button Grid.Column="8"
                        MinWidth="86"
                        VerticalAlignment="Bottom"
                        Command="{Binding DetachCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTip="Detach the debugger from the target."
                        Content="Detach" />

                <TextBlock Grid.Column="10"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,5"
                           Text="Events"
                           Style="{StaticResource MutedTextStyle}" />
                <TextBlock Grid.Column="11"
                           VerticalAlignment="Bottom"
                           Margin="8,0,0,5"
                           Text="{Binding Events.Count}" />
                <Button Grid.Column="12"
                        MinWidth="96"
                        VerticalAlignment="Bottom"
                        Command="{Binding ClearEventsCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="Clear Events" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Width="390"
                  Visibility="{Binding HasThreadEnumerationCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Threads"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="{Binding Threads.Count}"
                                       Style="{StaticResource MutedTextStyle}" />
                            <Button Grid.Column="4"
                                    MinWidth="76"
                                    Command="{Binding RefreshThreadsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Refresh" />
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Threads}"
                                  SelectedItem="{Binding SelectedThread, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  EnableRowVirtualization="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thread" Binding="{Binding IdText}" Width="86" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="90" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="86" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding HasThreadControlCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button MinWidth="92"
                                    Margin="0,0,8,0"
                                    Command="{Binding SuspendThreadCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Suspend" />
                            <Button MinWidth="92"
                                    Command="{Binding ResumeThreadCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Resume" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Height="12"
                        Visibility="{Binding HasRegisterAccessCapability, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Grid.Row="2"
                        Height="210"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        Visibility="{Binding HasRegisterAccessCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Registers"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="{Binding Registers.Count}"
                                       Style="{StaticResource MutedTextStyle}" />
                            <Button Grid.Column="4"
                                    MinWidth="76"
                                    Command="{Binding RefreshRegistersCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Refresh the selected thread's register snapshot while the target is paused."
                                    Content="Refresh" />
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Registers}"
                                  SelectedItem="{Binding SelectedRegister, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  EnableRowVirtualization="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Register" Binding="{Binding DisplayName}" Width="78" />
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="96" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="IP"
                                       Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       Text="{Binding CurrentInstructionPointerText}" />
                            <Button Grid.Column="4"
                                    MinWidth="70"
                                    IsEnabled="{Binding CanEditSelectedRegister}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="EditRegisterButton_Click"
                                    Content="Edit..." />
                            <Button Grid.Column="6"
                                    MinWidth="104"
                                    IsEnabled="{Binding CanNavigateToCurrentInstruction}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenCurrentInstructionButton_Click"
                                    Content="Disassembler..." />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Width="12"
                    Visibility="{Binding HasThreadEnumerationCapability, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Events}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="64" />
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="105" />
                        <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="120" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="105" />
                        <DataGridTextColumn Header="Stop Reason" Binding="{Binding StopReason}" Width="130" />
                        <DataGridTextColumn Header="Thread" Binding="{Binding Thread}" Width="100" />
                        <DataGridTextColumn Header="Instruction Pointer" Binding="{Binding InstructionPointer}" Width="150" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="6" Style="{StaticResource CardBorderStyle}" Padding="12,9">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ErrorText}"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
