<Window x:Class="TeeKay87.MemoryEngine.App.DebuggerWindow"
        Icon="/TeeKay87.MemoryEngine;component/Assets/TK87ME.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TeeKay87.MemoryEngine.App.Controls"
        Title="{Binding WindowTitle}"
        Width="1240"
        Height="780"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        Closed="DebuggerWindow_Closed">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
            <StackPanel>
                <TextBlock Text="Debugger" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding TargetText}"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="State" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="0,3,0,0"
                                   MinWidth="80"
                                   Text="{Binding StateText}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            MinWidth="86"
                            VerticalAlignment="Bottom"
                            Command="{Binding AttachCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Attach the debugger to this window's bound Active Target."
                            Content="Attach" />
                    <Button Grid.Column="4"
                            MinWidth="86"
                            VerticalAlignment="Bottom"
                            Command="{Binding PauseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Pause the attached target."
                            Content="Pause" />
                    <Button Grid.Column="6"
                            MinWidth="86"
                            VerticalAlignment="Bottom"
                            Command="{Binding ContinueCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Continue a paused target."
                            Content="Continue" />
                    <Button Grid.Column="8"
                            MinWidth="86"
                            VerticalAlignment="Bottom"
                            Command="{Binding DetachCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Detach the debugger from the target."
                            Content="Detach" />
                    <Button Grid.Column="10"
                            MinWidth="86"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanExportDebuggerData}"
                            Click="ExportDebuggerButton_Click"
                            Content="Export..." />
                </Grid>

                <WrapPanel Grid.Row="2"
                           HorizontalAlignment="Left"
                           Visibility="{Binding HasStepExecutionCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button MinWidth="92"
                            Margin="0,0,8,0"
                            Command="{Binding StepIntoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Step Into" />
                    <Button MinWidth="92"
                            Margin="0,0,8,0"
                            Command="{Binding StepOverCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Step Over" />
                    <Button MinWidth="92"
                            Margin="0,0,8,0"
                            Command="{Binding StepOutCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Step Out" />
                    <Button MinWidth="92"
                            IsEnabled="{Binding CanRunToAddress}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RunToAddressButton_Click"
                            Content="Run to..." />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="64*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Visibility="{Binding HasThreadEnumerationCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="{x:Type RowDefinition}">
                                <Setter Property="Height" Value="*" />
                                <Setter Property="MinHeight" Value="120" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRegisterAccessCapability}" Value="False">
                                        <Setter Property="Height" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Threads" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Threads.Count}" Style="{StaticResource MutedTextStyle}" />
                            <Button Grid.Column="4" MinWidth="76" Command="{Binding RefreshThreadsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" />
                        </Grid>
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Threads}"
                                  SelectedItem="{Binding SelectedThread, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  EnableRowVirtualization="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thread" Binding="{Binding IdText}" Width="86" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="90" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="86" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding HasThreadControlCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button MinWidth="92" Margin="0,0,8,0" Command="{Binding SuspendThreadCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Suspend" />
                            <Button MinWidth="92" Command="{Binding ResumeThreadCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Resume" />
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:ProportionalGridSplitter Grid.Row="1"
                                                   Style="{StaticResource RowWorkspaceSplitterStyle}"
                                                   ResizeDirection="Rows"
                                                   ResizeBehavior="PreviousAndNext"
                                                   MinimumPreviousRatio="0.2"
                                                   MaximumPreviousRatio="0.8"
                                                   ShowsPreview="False"
                                                   Visibility="{Binding HasRegisterAccessCapability, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        Visibility="{Binding HasRegisterAccessCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Registers" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Registers.Count}" Style="{StaticResource MutedTextStyle}" />
                            <Button Grid.Column="4"
                                    MinWidth="76"
                                    Command="{Binding RefreshRegistersCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Refresh the selected thread's register snapshot while the target is paused."
                                    Content="Refresh" />
                        </Grid>
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Registers}"
                                  SelectedItem="{Binding SelectedRegister, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  EnableRowVirtualization="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Register" Binding="{Binding DisplayName}" Width="78" />
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="96" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="IP" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding CurrentInstructionPointerText}" />
                            <Button Grid.Column="4" MinWidth="70" IsEnabled="{Binding CanEditSelectedRegister}" Style="{StaticResource SecondaryButtonStyle}" Click="EditRegisterButton_Click" Content="Edit..." />
                            <Button Grid.Column="6" MinWidth="104" IsEnabled="{Binding CanNavigateToCurrentInstruction}" Style="{StaticResource PrimaryButtonStyle}" Click="OpenCurrentInstructionButton_Click" Content="Disassembler..." />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <controls:ProportionalGridSplitter Grid.Column="1"
                                               Style="{StaticResource ColumnWorkspaceSplitterStyle}"
                                               ResizeDirection="Columns"
                                               ResizeBehavior="PreviousAndNext"
                                               MinimumPreviousRatio="0.2"
                                               MaximumPreviousRatio="0.8"
                                               ShowsPreview="False" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="{x:Type RowDefinition}">
                                <Setter Property="Height" Value="13*" />
                                <Setter Property="MinHeight" Value="150" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpperDebuggerWorkspaceCapability}" Value="False">
                                        <Setter Property="Height" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7*" MinHeight="150" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="8"
                        Visibility="{Binding HasUpperDebuggerWorkspaceCapability, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="4,0,4,0"
                                    Orientation="Horizontal">
                            <Button MinWidth="150"
                                    Margin="0,0,6,0"
                                    Command="{Binding ShowBreakpointsWorkspaceCommand}"
                                    Style="{StaticResource DebuggerBreakpointsSwitchButtonStyle}"
                                    Visibility="{Binding HasBreakpointManagementCapability, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Content="Breakpoints / Watchpoints" />
                            <Button MinWidth="92"
                                    Command="{Binding ShowCallStackWorkspaceCommand}"
                                    Style="{StaticResource DebuggerCallStackSwitchButtonStyle}"
                                    Visibility="{Binding HasCallStackCapability, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Content="Call Stack" />
                        </StackPanel>

                        <Grid Grid.Row="2"
                              Margin="4,0,4,4"
                              Visibility="{Binding IsBreakpointsWorkspaceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding Breakpoints}"
                                      SelectedItem="{Binding SelectedBreakpoint, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" Width="145" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="82" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="92" />
                                    <DataGridTextColumn Header="Mechanism" Binding="{Binding Mechanism}" Width="92" />
                                    <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="82" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60" />
                                    <DataGridTextColumn Header="Lifetime" Binding="{Binding Lifetime}" Width="*" MinWidth="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <Button MinWidth="80" Margin="0,0,8,0" Command="{Binding EnableBreakpointCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Enable" />
                                    <Button MinWidth="80" Margin="0,0,8,0" Command="{Binding DisableBreakpointCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Disable" />
                                    <Button MinWidth="80" Margin="0,0,8,0" Command="{Binding RemoveBreakpointCommand}" Style="{StaticResource DangerButtonStyle}" Content="Remove" />
                                    <Button MinWidth="92" Margin="0,0,8,0" IsEnabled="{Binding CanRemoveAllBreakpoints}" Style="{StaticResource DangerButtonStyle}" Click="RemoveAllBreakpointsButton_Click" Content="Remove All" />
                                    <Button MinWidth="104" IsEnabled="{Binding CanNavigateToSelectedBreakpoint}" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSelectedBreakpointButton_Click" Content="Disassembler..." />
                                </WrapPanel>
                                <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <Button MinWidth="76" Margin="0,0,8,0" IsEnabled="{Binding CanAddBreakpoint}" Style="{StaticResource PrimaryButtonStyle}" Click="AddBreakpointButton_Click" Content="Add..." />
                                    <Button MinWidth="76" Command="{Binding RefreshBreakpointsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" />
                                </WrapPanel>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="4,0,4,4"
                              Visibility="{Binding IsCallStackWorkspaceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="CallStackDataGrid"
                                      Grid.Row="0"
                                      ItemsSource="{Binding CallFrames}"
                                      SelectedItem="{Binding SelectedStackFrame, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      MouseDoubleClick="CallStackDataGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="48" />
                                    <DataGridTextColumn Header="Instruction Address" Binding="{Binding InstructionAddressText}" Width="150" />
                                    <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding SymbolName}" Width="*" MinWidth="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2">
                                <TextBlock Margin="0,0,6,0" Text="SP" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Margin="0,0,18,0" FontFamily="Consolas" Text="{Binding SelectedStackFrame.StackPointerText}" />
                                <TextBlock Margin="0,0,6,0" Text="FP" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Margin="0,0,18,0" FontFamily="Consolas" Text="{Binding SelectedStackFrame.FramePointerText}" />
                                <TextBlock Margin="0,0,6,0" Text="Return" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock FontFamily="Consolas" Text="{Binding SelectedStackFrame.ReturnAddressText}" />
                            </WrapPanel>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <Button MinWidth="112" Margin="0,0,8,0" IsEnabled="{Binding CanNavigateToSelectedFrameDisassembler}" Style="{StaticResource PrimaryButtonStyle}" Click="OpenSelectedCallFrameDisassemblerButton_Click" Content="Disassembler..." />
                                    <Button MinWidth="116" IsEnabled="{Binding CanNavigateToSelectedFrameMemoryViewer}" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSelectedCallFrameMemoryViewerButton_Click" Content="Memory Viewer..." />
                                </WrapPanel>
                                <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <Button MinWidth="92" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="OpenComparerButton_Click" Content="Compare..." />
                                    <Button MinWidth="76" Command="{Binding RefreshCallStackCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" />
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <controls:ProportionalGridSplitter Grid.Row="1"
                                                   Style="{StaticResource RowWorkspaceSplitterStyle}"
                                                   ResizeDirection="Rows"
                                                   ResizeBehavior="PreviousAndNext"
                                                   MinimumPreviousRatio="0.2"
                                                   MaximumPreviousRatio="0.8"
                                                   ShowsPreview="False"
                                                   Visibility="{Binding HasUpperDebuggerWorkspaceCapability, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Events" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Events.Count}" Style="{StaticResource MutedTextStyle}" />
                            <Button Grid.Column="4" MinWidth="96" Command="{Binding ClearEventsCommand}" Style="{StaticResource DangerButtonStyle}" Content="Clear Events" />
                        </Grid>
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Events}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="64" />
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="105" />
                                <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="120" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="105" />
                                <DataGridTextColumn Header="Stop Reason" Binding="{Binding StopReason}" Width="130" />
                                <DataGridTextColumn Header="Thread" Binding="{Binding Thread}" Width="100" />
                                <DataGridTextColumn Header="Instruction Pointer" Binding="{Binding InstructionPointer}" Width="150" />
                                <DataGridTextColumn Header="Trigger Instruction" Binding="{Binding TriggerInstruction}" Width="145" />
                                <DataGridTextColumn Header="Watched Address" Binding="{Binding WatchedAddress}" Width="145" />
                                <DataGridTextColumn Header="Trigger Resolution" Binding="{Binding TriggerResolution}" Width="145" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="6" Style="{StaticResource CardBorderStyle}" Padding="12,9">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ErrorText}"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
